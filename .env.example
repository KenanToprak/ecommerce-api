# Database connection string
# Local SQLite (default if omitted): sqlite:///./ecommerce.db
# PostgreSQL example:
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/ecommerce_db

# JWT signing key (REQUIRED in production; generate e.g. with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=change-this-to-a-strong-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Allowed CORS origins (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
